{
  "openapi": "3.1.0",
  "info": {
    "title": "OreBridge read-only local gateway",
    "version": "2.0.0",
    "description": "Local site adapter and static replay documents; no write or control operations."
  },
  "paths": {
    "/api/index": {
      "get": {
        "responses": {
          "200": {
            "description": "Validated read-only document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseIndex"
                }
              }
            }
          },
          "503": {
            "description": "Explicit unavailable state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/plant": {
      "get": {
        "responses": {
          "200": {
            "description": "Validated read-only document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantGraph"
                }
              }
            }
          },
          "503": {
            "description": "Explicit unavailable state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/engines": {
      "get": {
        "responses": {
          "200": {
            "description": "Validated read-only document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineEvidence"
                }
              }
            }
          },
          "503": {
            "description": "Explicit unavailable state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/readiness": {
      "get": {
        "responses": {
          "200": {
            "description": "Validated read-only document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Explicit unavailable state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/observations": {
      "get": {
        "responses": {
          "200": {
            "description": "Authenticated read-only observation snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema",
                    "source",
                    "graph_revision",
                    "records"
                  ],
                  "properties": {
                    "schema": {
                      "const": "orebridge.observations/v1"
                    },
                    "source": {
                      "const": "site-opc-ua"
                    },
                    "graph_revision": {
                      "type": "string",
                      "minLength": 1
                    },
                    "records": {
                      "type": "array",
                      "minItems": 0,
                      "items": {
                        "$ref": "#/components/schemas/Observation"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PlantParams": {
        "$ref": "schemas/params-record.schema.json"
      },
      "CaseIndex": {
        "$ref": "schemas/case-index.schema.json"
      },
      "CaseManifest": {
        "$ref": "schemas/case-manifest.schema.json"
      },
      "Trace": {
        "$ref": "schemas/trace.schema.json"
      },
      "PlantGraph": {
        "$ref": "schemas/plant-graph.schema.json"
      },
      "EngineEvidence": {
        "$ref": "schemas/engine-evidence.schema.json"
      },
      "StateModel": {
        "$ref": "schemas/state-model.schema.json"
      },
      "Observation": {
        "$ref": "schemas/observation.schema.json"
      },
      "Benchmark": {
        "$ref": "schemas/benchmark.schema.json"
      },
      "Downstream": {
        "$ref": "schemas/downstream.schema.json"
      },
      "BenchmarkAnalysis": {
        "$ref": "schemas/benchmark-analysis.schema.json"
      },
      "Readiness": {
        "$ref": "schemas/readiness.schema.json"
      },
      "UnavailableBody": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "reason"
            ],
            "properties": {
              "state": {
                "const": "missing"
              },
              "reason": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "en",
                  "es"
                ],
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "es": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
