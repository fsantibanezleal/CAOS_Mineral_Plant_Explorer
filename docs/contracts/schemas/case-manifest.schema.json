{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case-manifest.schema.json",
  "title": "CaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "title",
    "category",
    "seed",
    "params",
    "engine",
    "engine_version",
    "real_or_synthetic",
    "expected_band",
    "artifact",
    "lane",
    "gate",
    "metrics"
  ],
  "properties": {
    "schema": {
      "const": "orebridge.manifest/v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "seed": {
      "type": "integer"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "family",
        "seed",
        "severity",
        "noise",
        "steps"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "severity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "noise": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "steps": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000
        }
      }
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "real_or_synthetic": {
      "const": "synthetic"
    },
    "expected_band": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "trace_schema",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "const": "json"
        },
        "trace_schema": {
          "const": "orebridge.trace/v1"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "lane": {
      "const": "replay"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "pure_python",
        "input_contract",
        "scientific_replay"
      ],
      "properties": {
        "lane": {
          "const": "replay"
        },
        "pure_python": {
          "type": "boolean"
        },
        "input_contract": {
          "type": "boolean"
        },
        "scientific_replay": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "family",
          "seed",
          "severity",
          "numeric",
          "source_quality",
          "event",
          "detection_delay_s",
          "scored_points",
          "unscorable_points",
          "timing_alignment_s"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer"
          },
          "severity": {
            "type": "number"
          },
          "numeric": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tp",
              "fp",
              "fn",
              "tn",
              "precision",
              "recall",
              "false_positive_rate"
            ],
            "properties": {
              "tp": {
                "type": "integer"
              },
              "fp": {
                "type": "integer"
              },
              "fn": {
                "type": "integer"
              },
              "tn": {
                "type": "integer"
              },
              "precision": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recall": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "false_positive_rate": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "source_quality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tp",
              "fp",
              "fn",
              "tn",
              "precision",
              "recall",
              "false_positive_rate"
            ],
            "properties": {
              "tp": {
                "type": "integer"
              },
              "fp": {
                "type": "integer"
              },
              "fn": {
                "type": "integer"
              },
              "tn": {
                "type": "integer"
              },
              "precision": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recall": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "false_positive_rate": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tp",
              "fp",
              "fn",
              "tn",
              "precision",
              "recall",
              "false_positive_rate"
            ],
            "properties": {
              "tp": {
                "type": "integer"
              },
              "fp": {
                "type": "integer"
              },
              "fn": {
                "type": "integer"
              },
              "tn": {
                "type": "integer"
              },
              "precision": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recall": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "false_positive_rate": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "detection_delay_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "scored_points": {
            "type": "integer"
          },
          "unscorable_points": {
            "type": "integer"
          },
          "timing_alignment_s": {
            "type": "integer"
          }
        }
      }
    }
  }
}
