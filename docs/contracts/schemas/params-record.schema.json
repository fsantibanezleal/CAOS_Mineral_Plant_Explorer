{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "params-record.schema.json",
  "title": "PlantParams",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "family",
    "seed",
    "severity",
    "noise",
    "steps"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "severity": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 5
    },
    "noise": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "steps": {
      "type": "integer",
      "minimum": 100,
      "maximum": 2000
    }
  }
}
