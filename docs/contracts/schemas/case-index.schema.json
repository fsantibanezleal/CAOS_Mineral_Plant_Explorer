{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case-index.schema.json",
  "title": "CaseIndex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engine_version",
    "n_cases",
    "default_case",
    "cases",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "orebridge.index/v1"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "n_cases": {
      "type": "integer",
      "minimum": 1
    },
    "default_case": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "title",
          "category",
          "manifest_path"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "es"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "category": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "es"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "manifest_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
