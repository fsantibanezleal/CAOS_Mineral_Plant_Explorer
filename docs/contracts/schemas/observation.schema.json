{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation.schema.json",
  "title": "Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tag_id",
    "asset_id",
    "value",
    "unit",
    "source_time",
    "server_time",
    "freshness_basis",
    "receipt_time",
    "sequence",
    "quality"
  ],
  "properties": {
    "tag_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "source_time": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "server_time": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness_basis": {
      "enum": [
        "source",
        "server"
      ]
    },
    "receipt_time": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "quality": {
      "enum": [
        "good",
        "uncertain",
        "bad"
      ]
    }
  }
}
