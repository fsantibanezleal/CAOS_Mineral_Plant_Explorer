  "properties": {
    "schema": {
      "const": "orebridge.benchmark/v1"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_seeds",
        "severity",
        "train_seeds",
        "forecast_calibration_seeds",
        "state_calibration_seeds",
        "point_adjustment",
        "channels",
        "steps",
        "numerical_quality_separation",
        "threshold_quantile"
      ],
      "properties": {
        "test_seeds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        },
        "severity": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
