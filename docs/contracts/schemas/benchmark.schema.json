        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "tp",
          "fp",
          "fn",
          "tn",
          "precision",
          "recall",
          "false_positive_rate",
          "cases",
          "scored_points",
          "unscorable_points"
