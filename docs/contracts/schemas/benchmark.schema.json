            "minLength": 1
          },
          "tp": {
            "type": "integer"
          },
          "fp": {
            "type": "integer"
          },
          "fn": {
            "type": "integer"
          },
          "tn": {
            "type": "integer"
          },
          "precision": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "recall": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "false_positive_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
