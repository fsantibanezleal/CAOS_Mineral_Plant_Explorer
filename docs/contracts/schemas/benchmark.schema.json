        "state_calibration_seeds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        },
        "point_adjustment": {
          "const": false
        },
        "channels": {
          "const": 16
        },
        "steps": {
          "const": 160
        },
        "numerical_quality_separation": {
          "const": true
        },
        "threshold_quantile": {
          "type": "number"
        }
      }
    },
