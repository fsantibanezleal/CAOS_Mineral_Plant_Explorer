      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "family",
          "seed",
          "severity",
          "numeric",
          "source_quality",
          "event",
          "detection_delay_s",
          "scored_points",
          "unscorable_points",
          "timing_alignment_s"
