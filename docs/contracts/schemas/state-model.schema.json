{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state-model.schema.json",
  "title": "StateModel",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "algorithm",
    "checkpoint_sha256",
    "train_seeds",
    "calibration_seeds"
  ],
  "properties": {
    "schema": {
      "const": "orebridge.state-model/v1"
    },
    "algorithm": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "train_seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer"
      }
    },
    "calibration_seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer"
      }
    }
  }
}
