{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "downstream.schema.json",
  "title": "Downstream",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "leach",
    "sx",
    "ew",
    "thickener",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "orebridge.downstream/v1"
    },
    "leach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feed_copper_kg_h",
        "dissolved_copper_kg_h",
        "residue_copper_kg_h",
        "acid_consumed_kg_h",
        "acid_limited"
      ],
      "properties": {
        "feed_copper_kg_h": {
          "type": "number"
        },
        "dissolved_copper_kg_h": {
          "type": "number"
        },
        "residue_copper_kg_h": {
          "type": "number"
        },
        "acid_consumed_kg_h": {
          "type": "number"
        },
        "acid_limited": {
          "type": "boolean"
        }
      }
    },
    "sx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raffinate_g_l",
        "transferred_copper_kg_h",
        "organic_loading_g_l",
        "organic_total_m3_h",
        "mass_residual_kg_h"
      ],
      "properties": {
        "raffinate_g_l": {
          "type": "number"
        },
        "transferred_copper_kg_h": {
          "type": "number"
        },
        "organic_loading_g_l": {
          "type": "number"
        },
        "organic_total_m3_h": {
          "type": "number"
        },
        "mass_residual_kg_h": {
          "type": "number"
        }
      }
    },
    "ew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cathode_kg_h",
        "faraday_limit_kg_h",
        "power_kw",
        "specific_energy_kwh_kg",
        "solution_limited"
      ],
      "properties": {
        "cathode_kg_h": {
          "type": "number"
        },
        "faraday_limit_kg_h": {
          "type": "number"
        },
        "power_kw": {
          "type": "number"
        },
        "specific_energy_kwh_kg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "solution_limited": {
          "type": "boolean"
        }
      }
    },
    "thickener": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "z_m",
        "fraction_profile",
        "solids_residual_m3",
        "underflow_fraction"
      ],
      "properties": {
        "z_m": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "fraction_profile": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "solids_residual_m3": {
          "type": "number"
        },
        "underflow_fraction": {
          "type": "number"
        }
      }
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    }
  }
}
