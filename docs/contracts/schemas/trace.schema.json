{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace.schema.json",
  "title": "Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "family",
    "provenance",
    "time_origin",
    "time_s",
    "channels",
    "observed",
    "valid",
    "truth",
    "fault",
    "quality_reasons",
    "scores",
    "estimate",
    "metrics",
    "threshold",
    "elapsed_ms"
  ],
  "properties": {
    "schema": {
      "const": "orebridge.trace/v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "const": "authored_synthetic_known_truth"
    },
    "time_origin": {
      "type": "string",
      "minLength": 1
    },
    "time_s": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "number"
      }
    },
    "channels": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "asset_id",
          "label",
          "unit",
          "nominal",
          "delay_s",
          "sigma"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "es"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "nominal": {
            "type": "number"
          },
          "delay_s": {
            "type": "number"
          },
          "sigma": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "observed": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "array",
        "minItems": 16,
        "items": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "valid": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "array",
        "minItems": 16,
        "items": {
          "type": "boolean"
        }
      }
    },
    "truth": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "array",
        "minItems": 16,
        "items": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fault": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "array",
        "minItems": 16,
        "items": {
          "type": "boolean"
        }
      }
    },
    "quality_reasons": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 100,
        "items": {
          "type": "array",
          "minItems": 16,
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "estimate": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "array",
        "minItems": 16,
        "items": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "family",
          "seed",
          "severity",
          "numeric",
          "source_quality",
          "event",
          "detection_delay_s",
          "scored_points",
          "unscorable_points",
          "timing_alignment_s"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer"
          },
          "severity": {
            "type": "number"
          },
          "numeric": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tp",
              "fp",
              "fn",
              "tn",
              "precision",
              "recall",
              "false_positive_rate"
            ],
            "properties": {
              "tp": {
                "type": "integer"
              },
              "fp": {
                "type": "integer"
              },
              "fn": {
                "type": "integer"
              },
              "tn": {
                "type": "integer"
              },
              "precision": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recall": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "false_positive_rate": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "source_quality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tp",
              "fp",
              "fn",
              "tn",
              "precision",
              "recall",
              "false_positive_rate"
            ],
            "properties": {
              "tp": {
                "type": "integer"
              },
              "fp": {
                "type": "integer"
              },
              "fn": {
                "type": "integer"
              },
              "tn": {
                "type": "integer"
              },
              "precision": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recall": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "false_positive_rate": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tp",
              "fp",
              "fn",
              "tn",
              "precision",
              "recall",
              "false_positive_rate"
            ],
            "properties": {
              "tp": {
                "type": "integer"
              },
              "fp": {
                "type": "integer"
              },
              "fn": {
                "type": "integer"
              },
              "tn": {
                "type": "integer"
              },
              "precision": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recall": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "false_positive_rate": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "detection_delay_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "scored_points": {
            "type": "integer"
          },
          "unscorable_points": {
            "type": "integer"
          },
          "timing_alignment_s": {
            "type": "integer"
          }
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 16,
        "items": {
          "type": "number"
        }
      }
    },
    "elapsed_ms": {
      "type": "number"
    }
  }
}
