{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-evidence.schema.json",
  "title": "EngineEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "records",
    "unavailable"
  ],
  "properties": {
    "schema": {
      "const": "orebridge.engine-evidence/v1"
    },
    "records": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "asset_id",
          "lane",
          "source_url",
          "version",
          "license",
          "provenance",
          "metrics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "lane": {
            "enum": [
              "upstream_replay",
              "executed_model"
            ]
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "label",
                "value",
                "unit"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "unavailable": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
